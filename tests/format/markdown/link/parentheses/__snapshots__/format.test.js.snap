exports[`parentheses.md format 1`] = `
====================================options=====================================
parsers: ["markdown", "mdx"]
                                                      printWidth: 80 (default) |
=====================================input======================================
[link](https://www.google.fr/(DATE)).

[Fish](https://en.wikipedia.org/wiki/Fish_(disambiguation))
![image](image_(1).png "title")

[link](foo(and(bar)))
[link](a(b(c(d))))
[link](a(b(c(d(e)))))

[link](foo\\)bar)
[link](foo\\(bar)

=====================================output=====================================
[link](https://www.google.fr/(DATE)).

[Fish](https://en.wikipedia.org/wiki/Fish_(disambiguation))
![image](image_(1).png "title")

[link](foo(and(bar)))
[link](a(b(c(d))))
[link](<a(b(c(d(e))))>)

[link](<foo)bar>)
[link](<foo(bar>)

================================================================================
`;
